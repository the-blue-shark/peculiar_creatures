{
	"schemaVersion": 1,
	"id": "peculiar_creatures",
	"version": "${version}",
	"name": "Peculiar Creatures",
	"description": "Adds peculiar creatures to your minecraft world.",
	"authors": [
		"the_blue_shark"
	],
	"contact": {
		"sources": "https://github.com/the-blue-shark/peculiar_creatures"
	},
	"license": "MIT",
	"icon": "assets/peculiar_creatures/textures/item/smurf_cat_hat.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.the_blue_shark.peculiar_creatures.PeculiarCreaturesMod"
		],
		"fabric-datagen": [
			"net.the_blue_shark.peculiar_creatures.PeculiarCreaturesModDataGenerator"
		],
		"client": [
			"net.the_blue_shark.peculiar_creatures.PeculiarCreaturesModClient"
		]
	},
	"mixins": [
		"peculiar_creatures.mixins.json"
	],
	"depends": {
		"fabricloader": "*",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"polymer-core": "*",
		"polymer-networking": "*",
		"polymer-virtual-entity": "*",
		"polymer-resource-pack": "*",
		"notica": "*"
	}

}